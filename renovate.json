{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchFileNames": [
        "src/requirements.txt"
      ],
      "matchPackageNames": [
        "Flask"
      ],
      "allowedVersions": "<3"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "pep440",
      "allowedVersions": "3.11"
    }
  ]
}
